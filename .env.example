VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SHARED_WORKSPACE_USER_ID=00000000-0000-0000-0000-000000000001
VITE_SUPABASE_STORAGE_BUCKET=documents

# Server-side only. Set this in Netlify/Vercel env vars, not in the public client.
OPENAI_API_KEY=your-server-side-openai-key

# Optional local-only fallback for `npm run dev`.
# This is not used in production builds.
VITE_OPENAI_API_KEY=your-local-dev-openai-key
